package com.ak.Entity;

import javax.persistence.Entity;
import javax.persistence.Table;
import javax.persistence.Id;


@Entity
@Table(name="profile")
public class Profile {
	@Id
  private int MyId;
  private String name;
  private String Sub;
  private String Clas;
public Profile() {
	super();
	// TODO Auto-generated constructor stub
}
public Profile(int myid, String name, String sub, String clas) {
	super();
	this.MyId = myid;
	this.name = name;
	this.Sub = sub;
	this.Clas = clas;
}
public int getId() {
	return MyId;
}
public void setId(int myid) {
	MyId = myid;
}
public String getName() {
	return name;
}
public void setName(String name) {
	this.name = name;
}
public String getSub() {
	return Sub;
}
public void setSub(String sub) {
	Sub = sub;
}
public String getClas() {
	return Clas;
}
public void setClas(String clas) {
	Clas = clas;
}
@Override
public String toString() {
	return  MyId +"\t"+ name +"\t"+  Sub +"\t"+  Clas ;
}

  
}
