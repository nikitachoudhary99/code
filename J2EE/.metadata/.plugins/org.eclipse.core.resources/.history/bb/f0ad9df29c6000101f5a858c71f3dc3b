    	p1.setSub(c1);
    	p2.setSub(c2);
    	
    	session.save(p1);
    	session.save(c1);
    	session.save(p1);
    	session.save(c2);
    	tnx.commit();
    	sf.close();
    	session.close();
    	
    
    }
}
