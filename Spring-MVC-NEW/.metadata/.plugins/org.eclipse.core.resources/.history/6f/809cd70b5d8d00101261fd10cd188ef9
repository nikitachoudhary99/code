package com.nc.controller;

import java.util.HashMap;
import java.util.List;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Controller;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.PutMapping;
import org.springframework.web.bind.annotation.RequestBody;

import com.nc.daoimpl.StudentDaoImpl;
import com.nc.pojo.Student;

@Controller
public class StudentController {
	@Autowired
	private StudentDaoImpl impl;
	
	@GetMapping("/getAllStudent")
	public List<Student> getAllStudent(){
		List<Student> lst= impl.getAllStudent();
	}
	
	
	@PostMapping("/addNewStudent")
	public HashMap<String, String> addStud(@RequestBody Student s){
		HashMap<String, String> hm=new HashMap<String, String>();
		 if (impl.addNewStudent(s))
		{
			hm.put("SUCCESS", "Student added successfully");
			
		}
		else
		{
			hm.put("ERROR", "Student could not be added");
		}
		return hm;
	}
	@PutMapping("/updateStudent")
	public HashMap<String, String> updateStud(@RequestBody Student s){
		HashMap<String, String> hm=new HashMap<String, String>();
		 if (impl.updateStudent(s))
		{
			hm.put("SUCCESS", "Student updated successfully");
			
		}
		else
		{
			hm.put("ERROR", "Student could not be updated");
		}
		return hm;
	}
	

}
