<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:mvc="http://www.springframework.org/schema/mvc"
	xmlns:context="http://www.springframework.org/schema/context"
	xsi:schemaLocation="
        http://www.springframework.org/schema/mvc http://www.springframework.org/schema/mvc/spring-mvc-3.0.xsd
        http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans-3.0.xsd
        http://www.springframework.org/schema/context http://www.springframework.org/schema/context/spring-context-3.0.xsd">
        
    <mvc:annotation-driven/>
	<context:component-scan base-package="com.univ.controller , com.univ.daoimpl"></context:component-scan>
	
	<mvc:resources location="/resources/img/" mapping="/img/**"></mvc:resources>
	<mvc:resources location="/resources/css/" mapping="/css/**"></mvc:resources>
	<mvc:resources location="/resources/js/" mapping="/js/**"></mvc:resources>
	<mvc:resources location="/resources/video/" mapping="/video/**"></mvc:resources>
	
	<bean class="org.springframework.jdbc.datasource.DriverManagerDataSource"
	name="ds">
		<property name="driverClassName" value="com.mysql.cj.jdbc.Driver"/>
		<property name="url" value="jdbc:mysql://localhost:3306/25june25jeespring"/>
		<property name="username" value="root"/>
		<property name="password" value="mishthu99"/>
	</bean>
	
	<bean class="org.springframework.jdbc.core.JdbcTemplate" name="jTemplate">
		<property name="dataSource" ref="ds"></property>
	</bean>
	
	<bean class="org.springframework.web.servlet.view.InternalResourceViewResolver"
	name="viewResolver">
		<property name="prefix" value="/WEB-INF/views/"></property>
		<property name="suffix" value=".jsp"></property>
	</bean>
</beans>