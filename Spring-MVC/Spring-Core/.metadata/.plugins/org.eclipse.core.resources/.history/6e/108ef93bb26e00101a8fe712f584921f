package com.univ.daoimpl;

import java.util.List;

import org.springframework.jdbc.core.BeanPropertyRowMapper;
import org.springframework.jdbc.core.JdbcTemplate;

import com.univ.dao.StudentDao;
import com.univ.pojo.Student;

public class StudentDaoImpl implements StudentDao{
 private JdbcTemplate JTemplate;
 
	public void setJTemplate(JdbcTemplate jTemplate) {
	JTemplate = jTemplate;
}

	@Override
	public boolean addStudent(Student std) {
		try {
			int count=JTemplate.update("insert into Student values(?,?,?)",
				new Object[] {std.getRoll(),std.getName(),std.getSub()});
			
			if(count>0)
				return true;
			else
				return false;
		} catch (Exception e) {
			e.getStackTrace();
			return false;
		}
	}

	@Override
	public boolean updateStudent(Student std) {
		try {
			int count=JTemplate.update("update  Student setname=?,sub=? where roll=?",
				
				new Object[] {std.getName(),std.getSub(),std.getRoll()});
			
			if(count>0)
				return true;
			else
				return false;
		} catch (Exception e) {
			e.getStackTrace();
			return false;
		}	}

	@Override
	public boolean deleteStudent(Student std) {
		try {
			int count=JTemplate.update("delete from Student where roll=?",
				
				new Object[] {std.getRoll()});
			
			if(count>0)
				return true;
			else
				return false;
		} catch (Exception e) {
			e.getStackTrace();
			return false;
		}	}	
