	@Override
	public Student searchStudent(int roll) {
	    try {
	        Student student = JTemplate.queryForObject(
	            "SELECT * FROM Student WHERE roll = ?",
	            new BeanPropertyRowMapper<>(Student.class),
	            roll
	        );
	        return student;
	    
	    } catch (Exception e) {
	        e.printStackTrace();
	        return null;
	    }
	}

	
	
	
	@Override
	public List<Student> getallStudents(int roll) {
		try {
			List<Student>lst;
			lst=JTemplate.query("select * from Student where roll=?",new BeanPropertyRowMapper<Student>(Student.class));
			
			if(lst.size()>0)
				return lst;
			else
				return null;
		} catch (Exception e) {
			e.getStackTrace();
			return null;
		}		
	}
}
