package com.univ;

import java.io.BufferedReader;
import java.io.InputStreamReader;
import java.util.List;
import java.util.Scanner;

import org.springframework.context.ApplicationContext;
import org.springframework.context.support.ClassPathXmlApplicationContext;

import com.univ.dao.ProductDao;
import com.univ.entities.Product;

public class App {
    public static void main(String[] args) {
        System.out.println("\n\t\t*********** Spring Core ORM Application Started Here....!!");

        ApplicationContext context = new ClassPathXmlApplicationContext("ormconfig.xml");

        ProductDao productDao = context.getBean("productDao", ProductDao.class);

        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));
        boolean flag = true;
        while (flag) {
            System.out.println();
            System.out.println("\t1. Add New Product");
            System.out.println("\t2. Display All Products");
            System.out.println("\t3. Display Single Product");
            System.out.println("\t4. Delete Product");
            System.out.println("\t5. Update Product");
            System.out.println("\t6. Exit");
            System.out.println();

            try {
                System.out.print("\tEnter Your Choice: ");
                int choice = Integer.parseInt(br.readLine());
                Scanner sc = new Scanner(System.in);

                switch (choice) {
                    case 1:
                        // Add New Product
                        Product p = new Product();
                        System.out.print("\tEnter Product Name: ");
                        p.setpName(sc.nextLine().trim());

                        System.out.print("\tEnter Product Price: ");
                        p.setPrice(sc.nextDouble());

                        int inserted = productDao.insert(p);
                        System.out.println("\n\t\t✅ Product Inserted Successfully! Rows affected: " + inserted);
                        break;

                    case 2:
                        // Display All Products
                        List<Product> allProducts = productDao.getAllProducts();
                        System.out.println("\n\tID\tName\t\tPrice");
                        System.out.println("\t-----------------------------------");
                        for (Product prod : allProducts) {
                            System.out.println("\t" + prod.getpId() + "\t" + prod.getpName() + "\t\t" + prod.getPrice());
                        }
                        break;

                    case 3:
                        // Display Single Product
                        System.out.print("\tEnter Product ID: ");
                        int pid = Integer.parseInt(br.readLine());
                        Product prod = productDao.getProduct(pid);
                        if (prod != null) {
                            System.out.println("\n\tProduct ID: " + prod.getpId());
                            System.out.println("\tProduct Name: " + prod.getpName());
                            System.out.println("\tProduct Price: " + prod.getPrice());
                        } else {
                            System.out.println("\t❌ Product Not Found.");
                        }
                        break;

                    case 4:
                        // Delete Product
                        System.out.print("\tEnter Product ID to Delete: ");
                        int delId = Integer.parseInt(br.readLine());
                        productDao.deleteProduct(delId);
                        System.out.println("\t✅ Product Deleted Successfully.");
                        break;

                    case 5:
                        // Update Product
                        Product updateP = new Product();

                        System.out.print("\tEnter Product ID: ");
                        updateP.setpId(sc.nextInt());
                        sc.nextLine(); // consume leftover newline

                        System.out.print("\tEnter New Product Name: ");
                        updateP.setpName(sc.nextLine().trim());

                        System.out.print("\tEnter New Product Price: ");
                        updateP.setPrice(sc.nextDouble());

                        productDao.updateProduct(updateP);
                        System.out.println("\t✅ Product Updated Successfully.");
                        break;

                    case 6:
                        flag = false;
                        break;

                    default:
                        System.out.println("\t❗ Invalid Choice.");
                }

            } catch (Exception e) {
                System.out.println("\t❗ Error: " + e.getMessage());
            }
        }

        System.out.println("\n\t****************************************");
        System.out.println("\t\tThank you... Visit Again..!!");
        System.out.println("\t****************************************");
    }
}
