package com.univ;

import java.io.BufferedReader;
import java.io.InputStreamReader;
import java.util.List;
import java.util.Scanner;

import org.springframework.context.ApplicationContext;
import org.springframework.context.support.ClassPathXmlApplicationContext;

import com.univ.dao.FruitDao;
import com.univ.entities.Fruit;

public class App {
    public static void main(String[] args) {
        System.out.println("\n\t\t*********** Spring Core ORM Fruit Application Started ***********");

        ApplicationContext context = new ClassPathXmlApplicationContext("ormconfig.xml");
        FruitDao fruitDao = context.getBean("fruitDao", FruitDao.class);
        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));
        Scanner sc = new Scanner(System.in);

        boolean flag = true;
        while (flag) {
            System.out.println();
            System.out.println("\t1. Add New Fruit");
            System.out.println("\t2. Display All Fruits");
            System.out.println("\t3. Display Single Fruit");
            System.out.println("\t4. Delete Fruit");
            System.out.println("\t5. Update Fruit");
            System.out.println("\t6. Exit");
            System.out.print("\n\tEnter your choice: ");

            try {
                int choice = Integer.parseInt(br.readLine());

                switch (choice) {
                    case 1:
                        // Add new fruit
                        Fruit fruit = new Fruit();

                        System.out.print("\tEnter Fruit Name: ");
                        fruit.setfName(sc.nextLine().trim());

                        System.out.print("\tEnter Quantity: ");
                        fruit.setQuantity(sc.nextInt());

                        System.out.print("\tEnter Price: ");
                        fruit.setPrice(sc.nextDouble());

                        int id = fruitDao.insert(fruit);
                        System.out.println("\t✅ Fruit inserted successfully with ID: " + id);
                        break;

                    case 2:
                        // Display all fruits
                        List<Fruit> fruits = fruitDao.getAllFruits();
                        System.out.println("\n\tID\tName\t\tQuantity\tPrice");
                        System.out.println("\t---------------------------------------------");
                        for (Fruit f : fruits) {
                            System.out.println("\t" + f.getId() + "\t" + f.getfName() + "\t\t" + f.getQuantity() + "\t\t" + f.getPrice());
                        }
                        break;

                    case 3:
                        // Display single fruit
                        System.out.print("\tEnter Fruit ID: ");
                        int fid = Integer.parseInt(br.readLine());
                        Fruit f = fruitDao.getFruit(fid);
                        if (f != null) {
                            System.out.println("\n\tFruit ID: " + f.getId());
                            System.out.println("\tName    : " + f.getfName());
                            System.out.println("\tQuantity: " + f.getQuantity());
                            System.out.println("\tPrice   : " + f.getPrice());
                        } else {
                            System.out.println("\t❌ Fruit not found!");
                        }
                        break;

                    case 4:
                        // Delete fruit
                        System.out.print("\tEnter Fruit ID to delete: ");
                        int did = Integer.parseInt(br.readLine());
                        fruitDao.deleteFruit(did);
                        System.out.println("\t✅ Fruit deleted successfully.");
                        break;

                    case 5:
                        // Update fruit
                        Fruit update = new Fruit();

                        System.out.print("\tEnter Fruit ID: ");
                        update.setQuantity(sc.nextInt());
                        sc.nextLine(); // clear buffer

                        System.out.print("\tEnter New Fruit Name: ");
                        update.setfName(sc.nextLine().trim());

                        System.out.print("\tEnter New Quantity: ");
                        update.setQuantity(sc.nextInt());

                        System.out.print("\tEnter New Price: ");
                        update.setPrice(sc.nextDouble());

                        fruitDao.updateFruit(update);
                        System.out.println("\t✅ Fruit updated successfully.");
                        break;

                    case 6:
                        flag = false;
                        break;

                    default:
                        System.out.println("\t❗ Invalid choice, try again.");
                }
            } catch (Exception e) {
                System.out.println("\t❗ Error: " + e.getMessage());
            }
        }

        System.out.println("\n\t***************************************************");
        System.out.println("\t\tThank you for using Fruit Manager!");
        System.out.println("\t***************************************************");

        sc.close();
    }
}
