			System.out.println("\t 6. Exit");
			System.out.println();
			Scanner sc = new Scanner(System.in);
			try {
				int choice=Integer.parseInt((br.readLine());
				switch (choice) {
				case 1:
					//add new fname
					Universal universal= new Universal();
					
