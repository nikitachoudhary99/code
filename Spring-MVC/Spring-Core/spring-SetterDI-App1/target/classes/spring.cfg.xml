<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="
        http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

    <!-- bean definitions here -->
    <bean class="com.univ.bean.Address" name="adr">
    <property name="hNo"><value>690</value></property>
    <property name="street"><value>near girls school</value></property>
    <property name="city"><value>Indore</value></property>
    </bean>
    <bean class="com.univ.bean.Employee" name="emp">
    <property name="empId"><value>101</value></property>
    <property name="empName"><value>ram</value></property>
    <property name="salary"><value>1000</value></property>
    
    </bean>
    
    </beans>