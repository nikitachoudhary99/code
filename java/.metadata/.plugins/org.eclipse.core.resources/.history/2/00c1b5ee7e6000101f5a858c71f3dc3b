package com.ak.Entity;

public class Profile {
  private int Id;
  private String name;
  private String Sub;
  private String Clas;
public Profile() {
	super();
	// TODO Auto-generated constructor stub
}
public Profile(int id, String name, String sub, String clas) {
	super();
	Id = id;
	this.name = name;
	Sub = sub;
	Clas = clas;
}
public int getId() {
	return Id;
}
public void setId(int id) {
	Id = id;
}
public String getName() {
	return name;
}
public void setName(String name) {
	this.name = name;
}
public String getSub() {
	return Sub;
}
public void setSub(String sub) {
	Sub = sub;
}
public String getClas() {
	return Clas;
}
public void setClas(String clas) {
	Clas = clas;
}
@Override
public String toString() {
	return  Id +"\t"+ name +"\t"+  Sub +"\t"+  Clas ;
}
  
}
